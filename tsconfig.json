{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "types": ["bun"],
    "paths": {
      "@yolo-web/shared": ["./packages/shared/src/index.ts"],
      "@yolo-web/shared/*": ["./packages/shared/src/*"],
      "@yolo-web/cdp-client": ["./packages/cdp-client/src/index.ts"],
      "@yolo-web/cdp-client/*": ["./packages/cdp-client/src/*"],
      "@yolo-web/mcp-client": ["./packages/mcp-client/src/index.ts"],
      "@yolo-web/mcp-client/*": ["./packages/mcp-client/src/*"],
      "@yolo-web/bun-v8-bridge": ["./packages/bun-v8-bridge/src/index.ts"],
      "@yolo-web/bun-v8-bridge/*": ["./packages/bun-v8-bridge/src/*"],
      "@yolo-web/browser-sdk": ["./packages/browser-sdk/src/index.ts"],
      "@yolo-web/browser-sdk/*": ["./packages/browser-sdk/src/*"],
      "@yolo-web/bun-mirror": ["./packages/bun-mirror/src/index.ts"],
      "@yolo-web/bun-mirror/*": ["./packages/bun-mirror/src/*"],
      "@yolo-web/brave-shields": ["./packages/brave-shields/src/index.ts"],
      "@yolo-web/brave-shields/*": ["./packages/brave-shields/src/*"],
      "@yolo-web/auth": ["./packages/auth/src/index.ts"],
      "@yolo-web/auth/*": ["./packages/auth/src/*"],
      "@yolo-web/google": ["./packages/google/src/index.ts"],
      "@yolo-web/google/*": ["./packages/google/src/*"],
      "@yolo-web/search-core": ["./packages/search-core/src/index.ts"],
      "@yolo-web/search-core/*": ["./packages/search-core/src/*"],
      "@yolo-web/standards": ["./packages/web-standards/src/index.ts"],
      "@yolo-web/standards/*": ["./packages/web-standards/src/*"],
      "@google-bun/free-context7": ["../yolo-plugins/packages/free-context7/src/index.ts"],
      "@google-bun/google-crawler": ["./packages/google-crawler/src/index.ts"],
      "@google-bun/google-indexer": ["./packages/google-indexer/src/index.ts"]
    }
  },
  "include": ["apps/**/*", "packages/**/*", "tools/**/*"],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/test/**",
    "**/tests/**",
    "packages/chrome-extension-yolo/**",
    "packages/yolo-agent/extension/**",
    "tools/site-audit/probes/**"
  ]
}
