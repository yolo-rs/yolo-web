{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebAssembly Core & Component Model Schema",
  "description": "Schema definition for Wasm Core binary structure, types, instructions, and Component Model interfaces",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "coreSpecUrl": { "type": "string", "format": "uri" },
    "componentModelSpecUrl": { "type": "string", "format": "uri" },
    "valTypes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "componentTypes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "canonicalAbis": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["version", "coreSpecUrl", "componentModelSpecUrl", "valTypes", "componentTypes", "sections"]
}
