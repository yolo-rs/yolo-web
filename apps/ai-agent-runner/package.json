{
  "name": "@yolo-web/ai-agent-runner",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Bun-based browser-agent orchestration runner with CDP, selector, and Shields integrations",
  "scripts": {
    "start": "bun src/index.ts",
    "aot": "bun build --compile --aot --bytecode --minify src/index.ts --outfile ../../dist/yolo-agent-runner",
    "test": "bun test",
    "check": "bun check"
  },
  "dependencies": {
    "@yolo-web/shared": "workspace:*",
    "@yolo-web/cdp-client": "workspace:*",
    "@yolo-web/mcp-client": "workspace:*",
    "@yolo-web/browser-sdk": "workspace:*",
    "@yolo-web/servo-bridge": "workspace:*",
    "@yolo-web/brave-shields": "workspace:*",
    "@yolo-web/bun-v8-bridge": "workspace:*"
  }
}
