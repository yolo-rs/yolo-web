{
  "name": "@yolo-web/human-browser",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Bun CDP service for browser control, policy, status, and screenshot streaming",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "aot": "bun build --compile --bytecode --minify src/server.ts --outfile ../../dist/yolo-human-browser",
    "test": "bun test",
    "check": "bun check"
  },
  "dependencies": {
    "@yolo-web/shared": "workspace:*",
    "@yolo-web/cdp-client": "workspace:*",
    "@yolo-web/mcp-client": "workspace:*",
    "@yolo-web/browser-sdk": "workspace:*",
    "@yolo-web/servo-bridge": "workspace:*",
    "@yolo-web/brave-shields": "workspace:*",
    "@yolo-web/bun-v8-bridge": "workspace:*"
  }
}
