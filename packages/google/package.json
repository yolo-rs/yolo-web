{
  "name": "@yolo-web/google",
  "version": "0.2.0",
  "description": "Google Cloud, Gemini, Drive, Docs, and search integration for YOLO-Web",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./types/google.d.ts",
  "bin": {
    "yolo-web-google": "./src/bun-google-cli.ts",
    "yolo-web-google-index-public": "./src/public-index-cli.ts",
    "gws": "./src/gws-cli.ts"
  },
  "files": ["src", "types", "README.md", "LICENSE-APACHE"],
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts",
    "./api": "./src/api.ts",
    "./drive-sync": "./src/drive-sync.ts",
    "./drive-model-sync": "./src/drive-model-sync.ts",
    "./services": "./src/services.ts",
    "./edge-proxy": "./src/edge-proxy.ts",
    "./fonts-proxy": "./src/fonts-proxy.ts",
    "./bun-plugin": "./src/bun-plugin.ts",
    "./gws": "./src/gws.ts",
    "./password-store": "./src/password-store.ts"
  },
  "scripts": {
    "check": "bun check --no-script",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --format esm",
    "test": "bun test ./test",
    "verify": "bun run test && bun run build"
  },
  "dependencies": {
    "@yolo-web/auth": "workspace:*",
    "@yolo-web/api-contract": "workspace:*",
    "@yolo-web/bun-plugin": "workspace:*",
    "@yolo-web/chromium": "workspace:*",
    "@ai-sdk/google-vertex": "^5.0.98",
    "@googleapis/docs": "^14.1.0",
    "@googleapis/drive": "^26.0.2",
    "ai": "^7.0.122",
    "google-auth-library": "11.1.0"
  }
}
