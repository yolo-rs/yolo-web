{
  "manifest_version": 3,
  "name": "YOLO-Web",
  "version": "0.3.0",
  "description": "Browser-use and computer-use agent for yolo-chromium: side panel, WebMCP, debugger driver. Aphrody search and new tab.",
  "homepage_url": "https://aphrody.com/",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "YOLO-Web Agent",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "chrome_settings_overrides": {
    "homepage": "https://aphrody.com/",
    "search_provider": {
      "name": "Aphrody",
      "keyword": "aphrody",
      "favicon_url": "https://aphrody.com/favicon.ico",
      "search_url": "https://aphrody.com/search?q={searchTerms}",
      "encoding": "UTF-8",
      "is_default": true
    }
  },
  "permissions": [
    "storage",
    "topSites",
    "favicon",
    "debugger",
    "tabs",
    "offscreen",
    "sidePanel"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "optional_permissions": ["history"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["webmcp-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["webmcp-relay.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
