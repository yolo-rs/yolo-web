{
  "manifest_version": 3,
  "name": "YOLO-Web",
  "version": "0.2.0",
  "description": "Aphrody search and a new tab page with live suggestions, shortcuts and recently opened pages, for yolo-chromium and Chrome.",
  "homepage_url": "https://aphrody.com/",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "YOLO-Web",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "chrome_settings_overrides": {
    "homepage": "https://aphrody.com/",
    "search_provider": {
      "name": "Aphrody",
      "keyword": "aphrody",
      "favicon_url": "https://aphrody.com/favicon.ico",
      "search_url": "https://aphrody.com/search?q={searchTerms}",
      "encoding": "UTF-8",
      "is_default": true
    }
  },
  "permissions": ["storage", "topSites", "favicon"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "optional_permissions": ["history"]
}
